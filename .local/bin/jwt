#!/usr/bin/env python3

"""Sample usage:

    $ jwt eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c
    Header:
    {
        "alg": "HS256",
        "typ": "JWT"
    }

    Payload:
    {
        "sub": "1234567890",
        "name": "John Doe",
        "iat": 1516239022
    }

"""

import base64
import json
import sys
from datetime import datetime, timezone


def decode_public_part(part):
    """Return the decoded JSON value, or None when the part is not JSON."""
    padded = part + "=" * (-len(part) % 4)
    try:
        return json.loads(base64.urlsafe_b64decode(padded))
    except ValueError:
        return None


def format_duration(seconds):
    """Return a short duration such as '1d 40m', '2h 5m' or '30s'."""
    seconds = int(abs(seconds))
    days, rest = divmod(seconds, 86400)
    hours, rest = divmod(rest, 3600)
    minutes, secs = divmod(rest, 60)
    parts = []
    if days:
        parts.append(f"{days}d")
    if hours:
        parts.append(f"{hours}h")
    if minutes:
        parts.append(f"{minutes}m")
    if not parts:
        parts.append(f"{secs}s")
    return " ".join(parts)


def format_expiry(exp):
    """Return a line such as 'Expires on ... (in 1d 40m)', or None when exp is not a number."""
    if isinstance(exp, bool) or not isinstance(exp, (int, float)):
        return None
    now = datetime.now(timezone.utc)
    when = datetime.fromtimestamp(exp, timezone.utc).astimezone()
    delta = (when - now).total_seconds()
    stamp = when.strftime("%Y-%m-%d %H:%M:%S %z")
    if delta >= 0:
        return f"Expires on {stamp} (in {format_duration(delta)})"
    return f"Expired on {stamp} ({format_duration(delta)} ago)"


def main():
    parts = sys.argv[1].split(".")
    for i, part in enumerate(parts, start=1):
        data = decode_public_part(part)
        if data is None:
            if i < 3:
                print(f"Can't decode part #{i}: {part}")
            continue
        is_header = isinstance(data, dict) and "alg" in data
        print("Header:" if is_header else "Payload:")
        print(json.dumps(data, indent=4))
        if not is_header and isinstance(data, dict) and "exp" in data:
            expiry = format_expiry(data["exp"])
            if expiry:
                print(expiry)
        if i < len(parts) and decode_public_part(parts[i]) is not None:
            print()


if __name__ == "__main__":
    main()
